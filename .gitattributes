# Force Unix line endings for scripts so they run correctly inside Linux containers
# (prevents the "env: 'bash\r': No such file or directory" error on Windows checkouts).
*.sh text eol=lf
*.py text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mako text eol=lf

# Binary assets stay binary.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
