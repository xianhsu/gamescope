# ─────────────────────────────────────────────────────────────
# GameScope environment. Copy to `.env` and fill in as needed.
# The system RUNS WITHOUT any API key using the local providers.
# NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# --- Core ---
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO

# --- Database (compose sets host to `postgres`) ---
POSTGRES_USER=gamescope
POSTGRES_PASSWORD=gamescope
POSTGRES_DB=gamescope
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full async URL (overrides the pieces above if set)
# DATABASE_URL=postgresql+asyncpg://gamescope:gamescope@localhost:5432/gamescope

# --- CORS: comma-separated frontend origins allowed to call the API ---
CORS_ORIGINS=http://localhost:3000

# --- LLM provider abstraction ---
# LLM_PROVIDER: "local" (default, no key, deterministic) | "openai" (OpenAI-compatible: OpenAI/DeepSeek/Qwen)
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# For DeepSeek/Qwen set the OpenAI-compatible base URL, e.g.:
#   DeepSeek: https://api.deepseek.com/v1     (LLM_MODEL=deepseek-chat)
#   Qwen:     https://dashscope.aliyuncs.com/compatible-mode/v1  (LLM_MODEL=qwen-plus)
LLM_BASE_URL=

# --- Embedding provider abstraction ---
# EMBEDDING_PROVIDER: "local" (default, deterministic hashing embedding) | "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
# Local provider dimension (must match the DB vector column; migration uses this default 1536)
EMBEDDING_DIM=1536

# --- Retrieval / freshness (config-driven, not hard-coded) ---
RETRIEVAL_FTS_LIMIT=15
RETRIEVAL_VECTOR_LIMIT=15
RETRIEVAL_FUSED_LIMIT=20
RETRIEVAL_CONTEXT_LIMIT=8
RRF_K=60
# Live retrieval (internet search for AI Search)
LIVE_RETRIEVAL_ENABLED=false
# Set to "serpapi" (and provide SERPAPI_API_KEY) to let AI Search query the live web.
# Time-sensitive queries (latest/recent/今天/最新/…) then enrich answers with cited web sources.
LIVE_RETRIEVAL_PROVIDER=null
SERPAPI_API_KEY=
FRESHNESS_MAX_AGE_HOURS=48        # local top result older than this may trigger live retrieval
FRESHNESS_MIN_LOCAL_RESULTS=3     # fewer local results than this may trigger live retrieval

# --- Ingestion ---
INGEST_HTTP_TIMEOUT=20
INGEST_MAX_ITEMS_PER_SOURCE=40
INGEST_DEDUP_LOOKBACK=500

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
